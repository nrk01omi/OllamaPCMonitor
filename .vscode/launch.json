{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ollama PC Monitor を起動",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "MONITOR_PORT": "11501",
        "PROXY_PORT": "11435",
        "PROXY_HOST": "0.0.0.0",
        "OLLAMA_LOG_DIR": "C:\\ollama\\logs"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Apply Ollama PC Monitor (install/update and restart)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-task-admin.ps1\" -Action Apply"
    },
    {
      "name": "Disable Ollama PC Monitor task self-heal",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-task-admin.ps1\" -Action DisableSelfHeal"
    }
  ]
}
